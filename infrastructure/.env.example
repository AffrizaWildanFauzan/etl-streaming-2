# Salin ke .env lalu sesuaikan:  make env   (atau: cp .env.example .env)

# --- PostgreSQL ---
POSTGRES_DB=metropolia
POSTGRES_USER=etl
POSTGRES_PASSWORD=ganti_password_ini
# Port Postgres di laptop (untuk DBeaver/psql). Ganti jika bentrok.
POSTGRES_HOST_PORT=5434

# --- Sumber data lalu lintas (streaming) ---
# tomtom    : data real TomTom Traffic API (wajib isi TOMTOM_API_KEY)
# simulator : data sintetis, HANYA untuk testing tanpa API key
TRAFFIC_SOURCE=tomtom
# Daftar gratis: https://developer.tomtom.com -> Dashboard -> Keys
TOMTOM_API_KEY=
# Kuota gratis 2.500 request/hari. 10 request per siklus x (86400/360) = 2.400/hari.
# Jangan diperkecil kecuali sebentar untuk demo.
POLL_SECONDS=360

# --- Kafka topics ---
FLOW_TOPIC=traffic.flow.raw
INCIDENT_TOPIC=traffic.incidents.raw
DLQ_TOPIC=traffic.dlq
PROCESSOR_GROUP_ID=traffic-processor

# --- Processor micro-batch ---
BATCH_SIZE=200
BATCH_TIMEOUT_MS=2000

# --- Airflow (UI: http://localhost:8081, user: admin) ---
AIRFLOW_ADMIN_PASSWORD=ganti_password_ini
